# Copy to .env and fill in. .env is never committed.

# Supabase project (Settings → API). The anon key is meant to be public:
# row-level security keeps each person's data their own. These two are built
# into the app, hence VITE_.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=

# For `npm run supabase:setup` and the two-device sync test only. A personal
# access token (supabase.com → Account → Access Tokens). Never prefix with VITE_.
SUPABASE_ACCESS_TOKEN=

# Optional: Google sign-in. Create an OAuth client (Web application) in Google
# Cloud; its authorized redirect URI is
#   https://your-project-ref.supabase.co/auth/v1/callback
# then run `npm run supabase:setup`. Never prefix with VITE_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where sign-in emails and Google send people back to (default http://localhost:5173),
# and any other addresses allowed (comma-separated).
SITE_URL=
EXTRA_REDIRECT_URLS=

# ESV (off unless MARGINS_ESV is set; the key is a server secret, never VITE_).
# MARGINS_ESV=
# ESV_API_KEY=
